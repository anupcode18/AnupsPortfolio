# ── Static site — no build artifacts ──────────────────

# OS / Editor junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor configs (optional — keep if you want to share settings)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node (if you ever add a local dev server or tooling)
node_modules/
npm-debug.log

# Environment / secrets — NEVER commit these
.env
.env.local
.env.*.local

# Build output (for future-proofing if tooling is added)
dist/
build/
out/
.cache/

# Serve / static server config (local only)
.serve/

# Temporary files
*.tmp
*.swp
*~

# Assets you intentionally keep out of git (large files, personal docs)
# Uncomment if you don't want resume tracked:
# assets/resume.pdf
